{
  "name": "rakshakai-v2",
  "displayName": "RakshakAI v2 — Security Copilot",
  "description": "AI security reviewer. Scans code on save, detects vulnerabilities, one-click AI fix.",
  "version": "2.1.0",
  "publisher": "RakshakAI",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.86.0" },
  "categories": ["Other", "Linters", "Programming Languages"],
  "keywords": ["security", "vulnerability", "cwe", "sast", "ai", "code-review", "copilot"],
  "activationEvents": [
    "onLanguage:python", "onLanguage:javascript", "onLanguage:typescript",
    "onLanguage:java", "onLanguage:go", "onLanguage:rust",
    "onLanguage:c", "onLanguage:cpp", "onLanguage:php",
    "onLanguage:csharp", "onLanguage:ruby"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "rakshak", "title": "RakshakAI", "icon": "$(shield)" }]
    },
    "views": {
      "rakshak": [
        {
          "type": "webview",
          "id": "rakshak-sidebar",
          "name": "Security Overview",
          "icon": "$(dashboard)",
          "contextualTitle": "RakshakAI"
        },
        {
          "id": "rakshak-files",
          "name": "Findings",
          "icon": "$(list-unordered)",
          "contextualTitle": "RakshakAI"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rakshak-files",
        "contents": [
          "### 🛡️ RakshakAI Security Scanner\nNo vulnerabilities detected yet.\n\n[Scan Current File](command:rakshakai.scanFile)\n\n[Scan Workspace](command:rakshakai.scanWorkspace)\n\n[Open Dashboard](command:rakshakai.dashboard)\n\n[Choose Provider](command:rakshakai.chooseProvider)"
        ]
      }
    ],
    "configuration": {
      "title": "RakshakAI v2",
      "properties": {
        "rakshakai.serverUrl": {
          "type": "string", "default": "http://localhost:8080",
          "description": "Server URL"
        },
        "rakshakai.scanOnSave": {
          "type": "boolean", "default": true,
          "description": "Scan on save"
        },
        "rakshakai.severityFilter": {
          "type": "array", "default": ["critical", "high", "medium"],
          "description": "Severity filter"
        },
        "rakshakai.minConfidence": {
          "type": "number", "default": 0.6, "minimum": 0, "maximum": 1,
          "description": "Min confidence"
        },
        "rakshakai.provider": {
          "type": "string", "default": "ollama",
          "enum": ["ollama", "groq", "fireworks", "nebius", "huggingface"],
          "enumDescriptions": [
            "Local Ollama (free, private)",
            "Groq (fast, free tier)",
            "Fireworks AI (paid)",
            "Nebius AI (Kimi K2.7, Qwen 3.5)",
            "HuggingFace (free tier)"
          ],
          "description": "LLM provider"
        },
        "rakshakai.model": {
          "type": "string", "default": "",
          "description": "Model ID override"
        },
        "rakshakai.notionEnabled": {
          "type": "boolean", "default": false,
          "description": "Enable Notion Security Hub integration"
        },
        "rakshakai.notionServerUrl": {
          "type": "string", "default": "http://localhost:8080",
          "description": "Server URL for Notion API"
        }
      }
    },
    "commands": [
      { "command": "rakshakai.scanFile", "title": "Scan Current File", "icon": "$(search)" },
      { "command": "rakshakai.scanWorkspace", "title": "Scan Workspace", "icon": "$(folder-opened)" },
      { "command": "rakshakai.dashboard", "title": "Open Dashboard", "icon": "$(graph)" },
      { "command": "rakshakai.chooseProvider", "title": "Choose Provider & Model", "icon": "$(settings-gear)" },
      { "command": "rakshakai.showLastFinding", "title": "Show Last Finding", "icon": "$(info)" },
      { "command": "rakshakai.showFindingDetails", "title": "Show Finding Details", "icon": "$(file-text)" },
      { "command": "rakshakai.applyPatch", "title": "Apply Suggested Patch", "icon": "$(code)" },
      { "command": "rakshakai.notionReport", "title": "Create Notion Security Report", "icon": "$(browser)" }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.86.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "axios": "^1.7.0"
  }
}
